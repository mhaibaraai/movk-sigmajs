{
  "name": "@movk/sigma",
  "type": "module",
  "version": "0.3.1",
  "packageManager": "pnpm@12.4.2",
  "description": "基于 sigma v4 的知识图谱可视化 Nuxt 模块：SigmaGraph 等声明式组件与 composables，覆盖渲染、交互、布局、分析与 DOM 覆盖层，面向 1000+ 节点的大规模图谱。",
  "author": "YiXuan <mhaibaraai@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhaibaraai/movk-sigmajs.git"
  },
  "bugs": {
    "url": "https://github.com/mhaibaraai/movk-sigmajs/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nuxt",
    "vite",
    "nuxt-module",
    "nuxt4",
    "vue",
    "sigma",
    "sigmajs",
    "graphology",
    "graph",
    "knowledge-graph",
    "network-visualization",
    "webgl",
    "composables"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "style": "./dist/runtime/index.css",
      "import": "./dist/module.mjs"
    },
    "./vue": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs"
    },
    "./vue-plugin": {
      "types": "./dist/vue-plugin.d.mts",
      "import": "./dist/vue-plugin.mjs"
    },
    "./index.css": "./dist/runtime/index.css",
    "./runtime/*": "./dist/runtime/*",
    "./components/*": "./dist/runtime/components/*",
    "./utils/*": {
      "types": "./dist/runtime/utils/*.d.ts",
      "import": "./dist/runtime/utils/*.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "vue": [
        "./dist/runtime/index.d.ts"
      ],
      "vite": [
        "./dist/vite.d.mts"
      ],
      "unplugin": [
        "./dist/unplugin.d.mts"
      ],
      "vue-plugin": [
        "./dist/vue-plugin.d.mts"
      ],
      "runtime/*": [
        "./dist/runtime/*"
      ],
      "components/*": [
        "./dist/runtime/components/*"
      ],
      "utils/*": [
        "./dist/runtime/utils/*.d.ts"
      ]
    }
  },
  "style": "./dist/runtime/index.css",
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "nuxt dev playgrounds/nuxt",
    "dev:vite": "pnpm --filter playground-vite dev",
    "dev:build": "nuxt build playgrounds/nuxt && pnpm --filter playground-vite build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playgrounds/nuxt && nuxt prepare docs && pnpm dev:vite:build",
    "docs": "nuxt dev docs",
    "docs:build": "nuxt build docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "vue-tsc --noEmit && nuxt typecheck playgrounds/nuxt && pnpm --filter playground-vite typecheck && nuxt typecheck docs",
    "release": "release-it",
    "clean": "movk-clean",
    "dev:vite:build": "pnpm --filter playground-vite build"
  },
  "dependencies": {
    "@movk/core": "^1.4.1",
    "@vueuse/core": "^15.0.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7"
  },
  "peerDependencies": {
    "@sigma/export-image": ">=4.0.0-beta.0",
    "@sigma/node-border": ">=4.0.0-alpha.3",
    "@sigma/node-image": ">=4.0.0-alpha.3",
    "@sigma/node-piechart": ">=4.0.0-alpha.3",
    "@sigma/utils": ">=4.0.0-alpha.2",
    "graphology": ">=0.26.0",
    "graphology-communities-louvain": ">=2.0.0",
    "graphology-layout": ">=0.6.0",
    "graphology-layout-forceatlas2": ">=0.10.0",
    "graphology-layout-noverlap": ">=0.4.0",
    "graphology-metrics": ">=2.0.0",
    "sigma": ">=4.0.0-beta.5",
    "unplugin": ">=2.0.0",
    "unplugin-auto-import": ">=20.0.0",
    "unplugin-vue-components": ">=31.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@sigma/export-image": {
      "optional": true
    },
    "@sigma/node-border": {
      "optional": true
    },
    "@sigma/node-image": {
      "optional": true
    },
    "@sigma/node-piechart": {
      "optional": true
    },
    "@sigma/utils": {
      "optional": true
    },
    "graphology-communities-louvain": {
      "optional": true
    },
    "graphology-layout": {
      "optional": true
    },
    "graphology-layout-forceatlas2": {
      "optional": true
    },
    "graphology-layout-noverlap": {
      "optional": true
    },
    "graphology-metrics": {
      "optional": true
    },
    "unplugin": {
      "optional": true
    },
    "unplugin-auto-import": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "release-it": "^21.0.3",
    "sigma": "4.0.0-beta.6",
    "typescript": "~6.0.3",
    "unbuild": "^3.6.1",
    "unplugin": "^3.4.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
